#include <iostream>
#include <locale>
using namespace std;
int main(){
    int n,k;
    cin >> n;
    int a[n];
    int b[n];
    for(int i = 0; i<n;i++){
        cin >> a[i];
    }
    for(int i=0; i<n;i++){
        cin >> b[i];
    }
    for(int i=0;i<(n-1);i++){
        int min=a[i];
        for(int j=i; j<n;++j){
            if(a[j]<min){
                min = a[j];
                k=j;
            }
        }
        a[k]=a[i];
        a[i]=min;
    }
    for(int i=0;i<n:i++){
        cout << a[i] << " ";
    }
    cout << endl;
    for(int i=0;i<n;++i){
        for(int j=n-1;j>i;--j){
            if(a[j-1]>a[j]){
                int m=a[j];
                a[j]=a[j-1];
                a[j-1]=m;
            }
        }
    }
    for(int i=0;i<n;i++){
        cout << a[i] << " ";
    }
    cout << endl;
    return 0;
}
